{
  "name": "@deepseek-ai/dsh-token-usage",
  "description": "Cross-session token-usage persistence: a SQLite-backed TokenUsageStore Service Definition that captures per-request provider-reported usage from the session firehose for daily, per-(provider, model) aggregation",
  "version": "0.1.2-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/my-dsh/dsh-token-usage-dashboard.git",
    "directory": "."
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./sqlite-provider": {
      "types": "./lib/types/sqlite-provider.d.ts",
      "default": "./lib/sqlite-provider.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./service": {
      "types": "./lib/types/remote.d.ts",
      "default": "./lib/remote.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/remote.js",
    "lib/sqlite-provider.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-invariants": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-llm": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-session": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-step-timing": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-zoned-time": "^0.1.2-alpha.1"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/cordis-plugin-include": "^4.0.1",
    "@deepseek-ai/cordis-plugin-loader": "^4.0.1",
    "@deepseek-ai/dsh-invariants": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-llm": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-session": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-step-timing": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-zoned-time": "^0.1.2-alpha.1"
  }
}
